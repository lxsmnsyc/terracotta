{
  "name": "@terracotta/docs",
  "version": "0.0.0",
  "private": true,
  "description": "Documentation site for Terracotta, the headless UI library for SolidJS",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && nitro build",
    "build:client": "vite build",
    "build:node": "vite build && NITRO_PRESET=node-server nitro build",
    "preview": "node .output/server/index.mjs",
    "lint": "oxlint --type-aware",
    "format": "oxfmt .",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:prod": "pnpm build:node && PROD=1 playwright test"
  },
  "dependencies": {
    "@solidjs/router": "2.0.0-next.21",
    "@solidjs/web": "catalog:",
    "solid-js": "catalog:",
    "terracotta": "workspace:*"
  },
  "devDependencies": {
    "@lxsmnsyc/oxlint-config": "catalog:",
    "@playwright/test": "catalog:",
    "@solidjs/vite-plugin": "catalog:",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "catalog:",
    "h3": "^1.15.11",
    "markdown-it": "^15.0.1",
    "nitropack": "^2.13.4",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "shiki": "^4.4.3",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "engines": {
    "node": ">=22.12"
  }
}
