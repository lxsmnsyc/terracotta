{
  "name": "terracotta",
  "version": "2.0.0-next.9",
  "private": false,
  "description": "Headless UI for SolidJS",
  "keywords": [
    "headless-ui",
    "pridepack",
    "solid-js"
  ],
  "homepage": "https://github.com/lxsmnsyc/terracotta/tree/main/packages/terracotta",
  "bugs": {
    "url": "https://github.com/lxsmnsyc/terracotta/issues"
  },
  "license": "MIT",
  "author": "Alexis Munsayac",
  "repository": {
    "type": "git",
    "url": "https://github.com/lxsmnsyc/terracotta.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "typesVersions": {
    "*": {}
  },
  "exports": {
    "./accordion": "./dist/accordion.js",
    "./alert": "./dist/alert.js",
    "./alert-dialog": "./dist/alert-dialog.js",
    "./button": "./dist/button.js",
    "./checkbox": "./dist/checkbox.js",
    "./color-scheme": "./dist/color-scheme.js",
    "./combobox": "./dist/combobox.js",
    "./command": "./dist/command.js",
    "./command-bar": "./dist/command-bar.js",
    "./context-menu": "./dist/context-menu.js",
    "./dialog": "./dist/dialog.js",
    "./disclosure": "./dist/disclosure.js",
    "./feed": "./dist/feed.js",
    "./listbox": "./dist/listbox.js",
    "./menu": "./dist/menu.js",
    "./popover": "./dist/popover.js",
    "./radio-group": "./dist/radio-group.js",
    "./select": "./dist/select.js",
    "./states": "./dist/states.js",
    "./tabs": "./dist/tabs.js",
    "./toast": "./dist/toast.js",
    "./toggle": "./dist/toggle.js",
    "./toolbar": "./dist/toolbar.js",
    "./transition": "./dist/transition.js",
    "./utils": "./dist/utils.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "tsdown",
    "build": "tsdown",
    "watch": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "e2e:dev": "vite --config e2e/vite.config.ts"
  },
  "dependencies": {
    "solid-use": "^1.0.0-next.3"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@solidjs/testing-library": "catalog:",
    "@solidjs/vite-plugin": "catalog:",
    "@solidjs/web": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@types/node": "catalog:",
    "jsdom": "catalog:",
    "solid-js": "catalog:",
    "tsdown": "catalog:",
    "tslib": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@solidjs/web": "^2.0.0-rc.0",
    "solid-js": "^2.0.0-rc.0"
  },
  "engines": {
    "node": ">=20"
  }
}
