{
  "name": "terracotta",
  "version": "1.3.0",
  "private": false,
  "description": "Headless UI for SolidJS",
  "keywords": [
    "headless-ui",
    "pridepack",
    "solid-js"
  ],
  "homepage": "https://github.com/lxsmnsyc/terracotta/tree/main/packages/terracotta",
  "bugs": {
    "url": "https://github.com/lxsmnsyc/terracotta/issues"
  },
  "license": "MIT",
  "author": "Alexis Munsayac",
  "repository": {
    "type": "git",
    "url": "https://github.com/lxsmnsyc/terracotta.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./dist/cjs/production/index.cjs",
  "module": "./dist/esm/production/index.mjs",
  "types": "./dist/types/index.d.ts",
  "typesVersions": {
    "*": {}
  },
  "exports": {
    ".": {
      "development": {
        "import": {
          "types": "./dist/types/index.d.ts",
          "default": "./dist/esm/development/index.mjs"
        },
        "require": {
          "types": "./dist/types/index.d.cts",
          "default": "./dist/cjs/development/index.cjs"
        }
      },
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/production/index.mjs"
      },
      "require": {
        "types": "./dist/types/index.d.cts",
        "default": "./dist/cjs/production/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsdown",
    "type-check": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "watch": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "e2e:dev": "vite --config e2e/vite.config.ts"
  },
  "dependencies": {
    "solid-use": "^0.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^7.0.0",
    "@types/node": "^25.0.3",
    "jsdom": "^30.0.1",
    "solid-js": "^1.9.10",
    "tsdown": "^0.23.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-solid": "^2.11.10",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "solid-js": "^1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
