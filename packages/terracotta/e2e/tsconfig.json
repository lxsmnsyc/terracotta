{
  "extends": "../tsconfig.json",
  "include": ["."],
  "compilerOptions": {
    "rootDir": "..",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "types": ["node"],
    "paths": {
      "terracotta": ["../src/index.ts"],
      "terracotta/states": ["../src/states/index.ts"],
      "terracotta/utils": ["../src/utils/index.ts"],
      "terracotta/*": ["../src/components/*"]
    }
  }
}
