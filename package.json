{
  "name": "root",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*",
    "docs"
  ],
  "scripts": {
    "cs:ver": "changeset version && pnpm install --lockfile-only",
    "cs:pub": "changeset publish",
    "cs:add": "changeset add",
    "skill:sync": "node scripts/sync-plugin-docs.mjs",
    "skill:check": "node scripts/sync-plugin-docs.mjs --check",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "release": "node scripts/publish.ts"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@lxsmnsyc/oxlint-config": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  }
}
